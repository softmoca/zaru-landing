# 자취선배 팀 빌딩 랜딩 계측용 환경변수
#
# 이 파일을 복사해 `.env.local` 로 만들고 실제 값을 채우세요.
# .env.local 은 .gitignore 에 있어 커밋되지 않습니다. (실제 키를 커밋하지 말 것)
#
# 값이 비어 있어도 앱은 정상 동작합니다. 전송 대신 콘솔에만 찍고 넘어갑니다.

# ── Supabase (페이지 조회 / 스크롤 깊이 / 세 순간 도달 / 팀 CTA) ───────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── GA4 (총량) ────────────────────────────────────────────────────────────
# 예: G-XXXXXXXXXX
VITE_GA4_ID=

# ── Microsoft Clarity (이탈 원인) ─────────────────────────────────────────
# 예: abcdefghij
VITE_CLARITY_ID=
