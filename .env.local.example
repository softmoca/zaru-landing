# 자루 랜딩 계측용 환경변수
#
# 이 파일을 복사해 `.env.local` 로 만들고 실제 값을 채우세요.
# .env.local 은 .gitignore 에 있어 커밋되지 않습니다. (실제 키를 커밋하지 말 것)
#
# ⚠️ 조립소(1차 아이템) 프로젝트와 반드시 다른 Supabase/GA4/Clarity 를 쓰세요.
#    같은 프로젝트를 재사용하면 1차 검증 데이터와 섞여 판정이 오염됩니다.
#
# 값이 비어 있어도 앱은 정상 동작합니다. 전송 대신 콘솔에만 찍고 넘어갑니다.

# ── Supabase (판정: 사전예약률 / 스크롤 깊이 / 스텝 도달) ──────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── GA4 (총량) ────────────────────────────────────────────────────────────
# 예: G-XXXXXXXXXX
VITE_GA4_ID=

# ── Microsoft Clarity (이탈 원인) ─────────────────────────────────────────
# 예: abcdefghij
VITE_CLARITY_ID=

# ── 카카오톡 채널 (CTA 보조 버튼 링크) ────────────────────────────────────
# 예: https://pf.kakao.com/_xxxxxxx
VITE_KAKAO_CHANNEL_URL=
